---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
---

<html lang="ja">
  <head>
    <BaseHead title="今夜の映画を探す | ぶたの記録と夜更かし映画メモ" description="気分で映画を探せる映画レコメンドページ" />
    <link href="https://fonts.googleapis.com/css2?family=Zen+Kaku+Gothic+New:wght@400;700;900&family=Bebas+Neue&display=swap" rel="stylesheet">
    <style>
      *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

      :root {
        --bg: #080808;
        --surface: #111111;
        --surface2: #1a1a1a;
        --border: rgba(255,255,255,0.07);
        --gold: #c9a84c;
        --gold-dim: rgba(201,168,76,0.15);
        --text: #e8e4dc;
        --muted: #555;
        --muted2: #888;
      }

      body {
        background: var(--bg);
        color: var(--text);
        font-family: 'Zen Kaku Gothic New', sans-serif;
        min-height: 100vh;
      }

      /* ヒーロー */
      .hero {
        position: relative;
        padding: 5rem 2rem 3rem;
        text-align: center;
        overflow: hidden;
      }

      .hero::before {
        content: '';
        position: absolute;
        inset: 0;
        background: radial-gradient(ellipse 60% 40% at 50% 0%, rgba(201,168,76,0.08) 0%, transparent 70%);
        pointer-events: none;
      }

      .perforation {
        display: flex;
        justify-content: center;
        gap: 1.2rem;
        margin-bottom: 2.5rem;
      }

      .perforation span {
        width: 18px;
        height: 12px;
        border: 1.5px solid rgba(255,255,255,0.12);
        border-radius: 2px;
        display: block;
      }

      .hero-eyebrow {
        font-family: 'Bebas Neue', sans-serif;
        letter-spacing: 0.3em;
        font-size: 0.8rem;
        color: var(--gold);
        margin-bottom: 1rem;
      }

      .hero-title {
        font-family: 'Bebas Neue', sans-serif;
        font-size: clamp(2.5rem, 8vw, 5rem);
        letter-spacing: 0.05em;
        line-height: 1;
        margin-bottom: 1rem;
        background: linear-gradient(180deg, #fff 0%, #aaa 100%);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
      }

      .hero-sub {
        font-size: 0.9rem;
        color: var(--muted2);
        letter-spacing: 0.05em;
      }

      /* メイン */
      .content {
        max-width: 820px;
        margin: 0 auto;
        padding: 0 1.5rem 6rem;
      }

      /* セクション */
      .q-section {
        margin-bottom: 1.5rem;
        border: 1px solid var(--border);
        border-radius: 4px;
        overflow: hidden;
        opacity: 0;
        transform: translateY(12px);
        animation: fadeUp 0.4s ease forwards;
      }

      .q-section:nth-child(1) { animation-delay: 0.05s; }
      .q-section:nth-child(2) { animation-delay: 0.10s; }
      .q-section:nth-child(3) { animation-delay: 0.15s; }
      .q-section:nth-child(4) { animation-delay: 0.20s; }
      .q-section:nth-child(5) { animation-delay: 0.25s; }
      .q-section:nth-child(6) { animation-delay: 0.30s; }
      .q-section:nth-child(7) { animation-delay: 0.35s; }
      .q-section:nth-child(8) { animation-delay: 0.40s; }

      @keyframes fadeUp {
        to { opacity: 1; transform: none; }
      }

      .q-header {
        display: flex;
        align-items: baseline;
        gap: 1rem;
        padding: 1.2rem 1.5rem;
        background: var(--surface);
        border-bottom: 1px solid var(--border);
      }

      .q-num {
        font-family: 'Bebas Neue', sans-serif;
        font-size: 1.4rem;
        color: var(--gold);
        letter-spacing: 0.1em;
        flex-shrink: 0;
      }

      .q-title {
        font-size: 1rem;
        font-weight: 700;
        letter-spacing: 0.04em;
      }

      .q-note {
        font-size: 0.75rem;
        color: var(--muted2);
        margin-top: 0.2rem;
      }

      .q-body {
        padding: 1.2rem 1.5rem;
        background: var(--surface2);
      }

      /* 選択肢 */
      .options {
        display: flex;
        flex-wrap: wrap;
        gap: 0.5rem;
      }

      .options.vertical {
        flex-direction: column;
        gap: 0.4rem;
      }

      .option {
        cursor: pointer;
        border: 1px solid rgba(255,255,255,0.1);
        background: rgba(255,255,255,0.03);
        color: var(--muted2);
        padding: 0.5rem 1rem;
        border-radius: 2px;
        font-size: 0.85rem;
        font-family: 'Zen Kaku Gothic New', sans-serif;
        transition: all 0.15s;
        user-select: none;
        line-height: 1.5;
      }

      .option:hover {
        border-color: rgba(201,168,76,0.4);
        color: var(--text);
        background: rgba(201,168,76,0.05);
      }

      .option.selected {
        border-color: var(--gold);
        color: var(--gold);
        background: var(--gold-dim);
      }

      .option.any-option.selected {
        border-color: var(--muted2);
        color: var(--muted2);
        background: rgba(255,255,255,0.05);
      }

      /* Q7 */
      .stimuli-grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 1.5rem;
      }

      @media (max-width: 520px) {
        .stimuli-grid { grid-template-columns: 1fr; }
      }

      .stimuli-label {
        font-size: 0.75rem;
        color: var(--muted2);
        letter-spacing: 0.06em;
        margin-bottom: 0.6rem;
        text-transform: uppercase;
      }

      /* ボタン */
      .submit-area {
        margin-top: 2.5rem;
        text-align: center;
      }

      .btn-search {
        position: relative;
        background: transparent;
        border: 1px solid var(--gold);
        color: var(--gold);
        padding: 1rem 4rem;
        font-family: 'Bebas Neue', sans-serif;
        font-size: 1.3rem;
        letter-spacing: 0.25em;
        cursor: pointer;
        transition: color 0.2s;
        overflow: hidden;
      }

      .btn-search::before {
        content: '';
        position: absolute;
        inset: 0;
        background: var(--gold);
        transform: scaleX(0);
        transform-origin: left;
        transition: transform 0.25s ease;
        z-index: 0;
      }

      .btn-search:hover::before { transform: scaleX(1); }
      .btn-search:hover { color: #080808; }

      .btn-search span {
        position: relative;
        z-index: 1;
      }

      /* 結果 */
      #result { margin-top: 4rem; }

      .result-header {
        font-family: 'Bebas Neue', sans-serif;
        font-size: 1.5rem;
        letter-spacing: 0.2em;
        color: var(--gold);
        margin-bottom: 1.5rem;
        padding-bottom: 0.5rem;
        border-bottom: 1px solid var(--border);
      }

      .movie-card {
        display: flex;
        gap: 1.2rem;
        border: 1px solid var(--border);
        border-radius: 4px;
        padding: 1.2rem;
        margin-bottom: 1rem;
        background: var(--surface);
        transition: border-color 0.2s, background 0.2s;
      }

      .movie-card:hover {
        border-color: rgba(201,168,76,0.25);
        background: var(--surface2);
      }

      .movie-poster {
        width: 80px;
        flex-shrink: 0;
        border-radius: 2px;
        object-fit: cover;
      }

      .movie-no-poster {
        width: 80px;
        height: 120px;
        flex-shrink: 0;
        background: #1a1a1a;
        border-radius: 2px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.5rem;
        color: var(--muted);
      }

      .movie-info h3 {
        font-size: 1rem;
        font-weight: 700;
        margin-bottom: 0.3rem;
        line-height: 1.4;
      }

      .movie-meta {
        font-size: 0.75rem;
        color: var(--muted2);
        margin-bottom: 0.5rem;
      }

      .movie-overview {
        font-size: 0.82rem;
        color: #888;
        line-height: 1.7;
        display: -webkit-box;
        -webkit-line-clamp: 3;
        -webkit-box-orient: vertical;
        overflow: hidden;
      }

      .loading-msg {
        text-align: center;
        padding: 3rem;
        color: var(--muted2);
        letter-spacing: 0.1em;
        font-size: 0.9rem;
      }

      .error-msg {
        color: #c0392b;
        font-size: 0.85rem;
        padding: 1rem;
        border: 1px solid rgba(192,57,43,0.3);
        border-radius: 4px;
      }
    </style>
  </head>

  <body>
    <Header />

    <div class="hero">
      <div class="perforation">
        <span></span><span></span><span></span><span></span><span></span>
        <span></span><span></span><span></span><span></span><span></span>
      </div>
      <p class="hero-eyebrow">TONIGHT'S FEATURE</p>
      <h1 class="hero-title">今夜の映画を探す</h1>
      <p class="hero-sub">気分を答えると、あなたに合う映画をおすすめします</p>
    </div>

    <div class="content">

      <div class="q-section">
        <div class="q-header">
          <span class="q-num">Q1</span>
          <div><p class="q-title">今の気分は？</p><p class="q-note">複数選択OK</p></div>
        </div>
        <div class="q-body">
          <div class="options" id="q1">
            <span class="option" data-q="q1" data-val="cry">泣きたい</span>
            <span class="option" data-q="q1" data-val="refresh">スカッとしたい</span>
            <span class="option" data-q="q1" data-val="thrill">ドキドキしたい</span>
            <span class="option" data-q="q1" data-val="scared">怖い思いしたい</span>
            <span class="option" data-q="q1" data-val="laugh">笑いたい・バカになりたい</span>
            <span class="option" data-q="q1" data-val="relax">癒されたい</span>
            <span class="option" data-q="q1" data-val="think">頭フル回転させたい</span>
            <span class="option" data-q="q1" data-val="nothing">何も考えたくない</span>
            <span class="option any-option" data-q="q1" data-val="any">なんでもOK</span>
          </div>
        </div>
      </div>

      <div class="q-section">
        <div class="q-header">
          <span class="q-num">Q2</span>
          <div><p class="q-title">見る状況は？</p><p class="q-note">複数選択OK</p></div>
        </div>
        <div class="q-body">
          <div class="options" id="q2">
            <span class="option" data-q="q2" data-val="alone">1人で夜中に</span>
            <span class="option" data-q="q2" data-val="friends">友達と</span>
            <span class="option" data-q="q2" data-val="lover">恋人と</span>
            <span class="option" data-q="q2" data-val="drink">酒飲みながら</span>
            <span class="option" data-q="q2" data-val="lazy">休日ダラダラ</span>
            <span class="option any-option" data-q="q2" data-val="any">気にしない</span>
          </div>
        </div>
      </div>

      <div class="q-section">
        <div class="q-header">
          <span class="q-num">Q3</span>
          <div><p class="q-title">作品の種類は？</p><p class="q-note">複数選択OK</p></div>
        </div>
        <div class="q-body">
          <div class="options" id="q3">
            <span class="option" data-q="q3" data-val="foreign">洋画</span>
            <span class="option" data-q="q3" data-val="japanese">邦画</span>
            <span class="option" data-q="q3" data-val="anime_world">海外アニメ</span>
            <span class="option" data-q="q3" data-val="anime_jp">国内アニメ</span>
            <span class="option any-option" data-q="q3" data-val="any">気にしない</span>
          </div>
        </div>
      </div>

      <div class="q-section">
        <div class="q-header">
          <span class="q-num">Q4</span>
          <div><p class="q-title">年代は？</p><p class="q-note">例はその時代を代表する映画 ／ 複数選択OK</p></div>
        </div>
        <div class="q-body">
          <div class="options vertical" id="q4">
            <span class="option" data-q="q4" data-val="1979">〜1979年（ゴッドファーザー1972・スター・ウォーズ1977・日本沈没1973）</span>
            <span class="option" data-q="q4" data-val="1980s">1980年代（ブレードランナー1982・バック・トゥ・ザ・フューチャー1985・ビー・バップ・ハイスクール1985）</span>
            <span class="option" data-q="q4" data-val="1990s">1990年代（ジュラシック・パーク1993・マトリックス1999・リング1998）</span>
            <span class="option" data-q="q4" data-val="2000s">2000年代（ロード・オブ・ザ・リング2001・ダークナイト2008・ALWAYS 三丁目の夕日2005）</span>
            <span class="option" data-q="q4" data-val="2010s">2010年代（アベンジャーズ2012・インターステラー2014・シン・ゴジラ2016）</span>
            <span class="option" data-q="q4" data-val="2020s">2020年代〜現在（スパイダーマン：ノー・ウェイ・ホーム2021・トップガン マーヴェリック2022・シン・ウルトラマン2022）</span>
            <span class="option any-option" data-q="q4" data-val="any">気にしない</span>
          </div>
        </div>
      </div>

      <div class="q-section">
        <div class="q-header">
          <span class="q-num">Q5</span>
          <div><p class="q-title">舞台・時代設定は？</p><p class="q-note">複数選択OK</p></div>
        </div>
        <div class="q-body">
          <div class="options" id="q5">
            <span class="option" data-q="q5" data-val="ancient">古代・神話・先史時代（恐竜・神々・古代文明）</span>
            <span class="option" data-q="q5" data-val="history">歴史・近世（戦国・戦争・王朝）</span>
            <span class="option" data-q="q5" data-val="modern">現代</span>
            <span class="option" data-q="q5" data-val="nearfuture">近未来</span>
            <span class="option" data-q="q5" data-val="scifi">SF未来（宇宙・AI・ロボット）</span>
            <span class="option any-option" data-q="q5" data-val="any">気にしない</span>
          </div>
        </div>
      </div>

      <div class="q-section">
        <div class="q-header">
          <span class="q-num">Q6</span>
          <div><p class="q-title">上映時間は？</p><p class="q-note">1つ選択</p></div>
        </div>
        <div class="q-body">
          <div class="options" id="q6">
            <span class="option" data-q="q6" data-val="60">〜60分</span>
            <span class="option" data-q="q6" data-val="90">〜90分</span>
            <span class="option" data-q="q6" data-val="120">〜120分</span>
            <span class="option" data-q="q6" data-val="150">〜150分</span>
            <span class="option" data-q="q6" data-val="over">それ以上でもOK</span>
            <span class="option any-option" data-q="q6" data-val="any">気にしない</span>
          </div>
        </div>
      </div>

      <div class="q-section">
        <div class="q-header">
          <span class="q-num">Q7</span>
          <div><p class="q-title">刺激物は？</p><p class="q-note">それぞれ1つ選択</p></div>
        </div>
        <div class="q-body">
          <div class="stimuli-grid">
            <div>
              <p class="stimuli-label">グロ・ゴア描写</p>
              <div class="options" id="q7_gore">
                <span class="option" data-q="q7_gore" data-val="ng">絶対NG</span>
                <span class="option" data-q="q7_gore" data-val="ok">少しならOK</span>
                <span class="option" data-q="q7_gore" data-val="welcome">むしろ歓迎</span>
              </div>
            </div>
            <div>
              <p class="stimuli-label">セクシーなシーン</p>
              <div class="options" id="q7_sexy">
                <span class="option" data-q="q7_sexy" data-val="ng">絶対NG</span>
                <span class="option" data-q="q7_sexy" data-val="ok">少しならOK</span>
                <span class="option" data-q="q7_sexy" data-val="welcome">むしろ歓迎</span>
              </div>
            </div>
          </div>
        </div>
      </div>

      <div class="q-section">
        <div class="q-header">
          <span class="q-num">Q8</span>
          <div><p class="q-title">ジャンルは？</p><p class="q-note">複数選択OK</p></div>
        </div>
        <div class="q-body">
          <div class="options" id="q8">
            <span class="option" data-q="q8" data-val="27">ホラー</span>
            <span class="option" data-q="q8" data-val="9648">サスペンス・ミステリー</span>
            <span class="option" data-q="q8" data-val="28">アクション</span>
            <span class="option" data-q="q8" data-val="878">SF</span>
            <span class="option" data-q="q8" data-val="35">コメディ</span>
            <span class="option" data-q="q8" data-val="18">ドラマ</span>
            <span class="option" data-q="q8" data-val="10749">恋愛</span>
            <span class="option any-option" data-q="q8" data-val="any">気にしない</span>
          </div>
        </div>
      </div>

      <div class="submit-area">
        <button class="btn-search" onclick="searchMovies()">
          <span>🎬 映画を探す</span>
        </button>
      </div>

      <div id="result"></div>
    </div>

    <Footer />

    <script>
      const API_KEY = '21ec4900e40b020539a7058c8a8ae56f';
      const SINGLE_SELECT = ['q6', 'q7_gore', 'q7_sexy'];
      const answers = {};

      document.querySelectorAll('.option').forEach(el => {
        el.addEventListener('click', () => {
          const q = el.dataset.q;
          const val = el.dataset.val;
          const isSingle = SINGLE_SELECT.includes(q);
          const isAny = val === 'any';

          if (isSingle) {
            document.querySelectorAll(`[data-q="${q}"]`).forEach(o => o.classList.remove('selected'));
            el.classList.add('selected');
            answers[q] = val;
            return;
          }

          if (isAny) {
            document.querySelectorAll(`[data-q="${q}"]`).forEach(o => o.classList.remove('selected'));
            el.classList.add('selected');
            answers[q] = ['any'];
          } else {
            const anyBtn = document.querySelector(`[data-q="${q}"][data-val="any"]`);
            if (anyBtn) anyBtn.classList.remove('selected');
            el.classList.toggle('selected');
            answers[q] = Array.from(document.querySelectorAll(`[data-q="${q}"].selected`)).map(o => o.dataset.val);
            if (answers[q].length === 0) answers[q] = undefined;
          }
        });
      });

      function buildParams() {
        const params = new URLSearchParams();
        params.set('api_key', API_KEY);
        params.set('language', 'ja-JP');
        params.set('sort_by', 'vote_average.desc');
        params.set('vote_count.gte', '150');
        params.set('page', String(Math.floor(Math.random() * 8) + 1));

        const moodGenreMap = {
          cry: '18', refresh: '28', thrill: '53',
          scared: '27', laugh: '35', relax: '10749',
          think: '9648', nothing: '35',
        };

        // Q3 言語
        const langs = answers.q3;
        if (langs && !langs.includes('any')) {
          if (langs.includes('japanese') || langs.includes('anime_jp')) {
            params.set('with_original_language', 'ja');
          } else if (langs.includes('foreign') && !langs.includes('anime_world')) {
            params.set('without_original_language', 'ja');
          }
          if (langs.includes('anime_world') || langs.includes('anime_jp')) {
            params.set('with_genres', '16');
          }
        }

        // Q4 年代
        const yearMap = {
          '1979': [null, 1979], '1980s': [1980, 1989],
          '1990s': [1990, 1999], '2000s': [2000, 2009],
          '2010s': [2010, 2019], '2020s': [2020, null],
        };
        const selectedYears = answers.q4;
        if (selectedYears && !selectedYears.includes('any')) {
          let minYear = Infinity, maxYear = -Infinity;
          selectedYears.forEach(v => {
            const [mn, mx] = yearMap[v] || [null, null];
            if (mn !== null && mn < minYear) minYear = mn;
            if (mx !== null && mx > maxYear) maxYear = mx;
          });
          if (minYear !== Infinity) params.set('primary_release_date.gte', `${minYear}-01-01`);
          if (maxYear !== -Infinity) params.set('primary_release_date.lte', `${maxYear}-12-31`);
        }

        // Q6 上映時間
        const runtimeMap = { '60': 60, '90': 90, '120': 120, '150': 150 };
        if (answers.q6 && runtimeMap[answers.q6]) {
          params.set('with_runtime.lte', String(runtimeMap[answers.q6]));
        }

        // Q8 ジャンル
        let genres = [];
        if (answers.q8 && !answers.q8.includes('any')) {
          genres = answers.q8.filter(v => v !== 'any');
        }
        if (genres.length === 0 && answers.q1 && !answers.q1.includes('any')) {
          genres = [...new Set(answers.q1.map(v => moodGenreMap[v]).filter(Boolean))];
        }
        if (genres.length > 0 && !params.has('with_genres')) {
          params.set('with_genres', genres.join(','));
        }

        return params;
      }

      async function searchMovies() {
        const resultDiv = document.getElementById('result');
        resultDiv.innerHTML = '<p class="loading-msg">── 映画を探しています ──</p>';
        resultDiv.scrollIntoView({ behavior: 'smooth', block: 'start' });

        try {
          const params = buildParams();
          const url = `https://api.themoviedb.org/3/discover/movie?${params.toString()}`;
          const res = await fetch(url);
          const data = await res.json();

          if (!data.results || data.results.length === 0) {
            resultDiv.innerHTML = '<p class="error-msg">条件に合う映画が見つかりませんでした。条件を緩めてもう一度お試しください。</p>';
            return;
          }

          const shuffled = data.results.sort(() => Math.random() - 0.5).slice(0, 5);
          let html = '<p class="result-header">── RECOMMENDED ──</p>';

          for (const movie of shuffled) {
            const poster = movie.poster_path
              ? `<img class="movie-poster" src="https://image.tmdb.org/t/p/w200${movie.poster_path}" alt="${movie.title}">`
              : `<div class="movie-no-poster">🎬</div>`;
            const year = movie.release_date ? movie.release_date.slice(0, 4) : '年不明';
            html += `
              <div class="movie-card">
                ${poster}
                <div class="movie-info">
                  <h3>${movie.title}</h3>
                  <p class="movie-meta">${year} ／ ⭐ ${movie.vote_average.toFixed(1)}</p>
                  <p class="movie-overview">${movie.overview || '説明なし'}</p>
                </div>
              </div>
            `;
          }

          resultDiv.innerHTML = html;

        } catch (e) {
          resultDiv.innerHTML = '<p class="error-msg">エラーが発生しました。しばらく経ってからお試しください。</p>';
        }
      }
    </script>
  </body>
</html>
